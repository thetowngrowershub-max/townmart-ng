# Backup settings for docker-compose.prod.yml (postgres and backup services).
# Copy to backup.env (not committed). See DATABASE.md, "Backups and restore".

# ── Nightly encrypted dumps (scripts/db/backup.sh) ───────────────────────────
# age public key(s) the dumps are encrypted to, space separated. Make a key pair
# on a trusted machine with `age-keygen -o backup-age-identity.txt` and keep the
# private key offline. Put a copy at ./secrets/backup-age-identity.txt only if
# this server should run the monthly restore drill.
BACKUP_AGE_RECIPIENTS=
# Second location for the dumps (rclone destination). Configure the remote with
# RCLONE_CONFIG_<NAME>_* variables, e.g. for an S3-compatible store in another
# provider or region:
#   BACKUP_OFFSITE=offsite:townmart-backups
#   RCLONE_CONFIG_OFFSITE_TYPE=s3
#   RCLONE_CONFIG_OFFSITE_PROVIDER=Other
#   RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
#   RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
BACKUP_OFFSITE=
# Retention (counts of files kept)
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# ── Point-in-time recovery (pgBackRest; WAL archived every minute) ───────────
# Encryption passphrase for the local repository. Generate: openssl rand -base64 48
# Store it in your password manager: without it the backups can't be read.
PGBACKREST_REPO1_CIPHER_PASS=
# Second repository in another provider or region (recommended):
# PGBACKREST_REPO2_TYPE=s3
# PGBACKREST_REPO2_PATH=/townmart
# PGBACKREST_REPO2_S3_BUCKET=
# PGBACKREST_REPO2_S3_ENDPOINT=s3.example.com
# PGBACKREST_REPO2_S3_REGION=us-east-1
# PGBACKREST_REPO2_S3_KEY=
# PGBACKREST_REPO2_S3_KEY_SECRET=
# PGBACKREST_REPO2_S3_URI_STYLE=path
# PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
# PGBACKREST_REPO2_CIPHER_PASS=
# PGBACKREST_REPO2_RETENTION_FULL=3

# Run a backup as soon as the backup service starts (first deploy, testing).
BACKUP_RUN_ON_START=
