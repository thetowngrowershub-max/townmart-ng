# ─────────────────────────────────────────────────────────────────────────────
# TownMart environment variables. Copy to `.env` and fill in.
# Every secret comes from the environment; nothing is hard-coded.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Public base URL of the site (used for links in emails and Auth.js callbacks)
APP_URL=http://localhost:3000
# Log level for pino: trace | debug | info | warn | error
LOG_LEVEL=info

# ── PostgreSQL 16 (self-hosted; TownMart owns the server) ────────────────────
# Superuser, used ONLY by the Docker init script / bootstrap to create roles.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=townmart
# Passwords for the three least-privilege roles created by sql/bootstrap/roles.sql
TOWNMART_MIGRATOR_PASSWORD=migrator-dev-only
TOWNMART_APP_PASSWORD=app-dev-only
TOWNMART_READONLY_PASSWORD=readonly-dev-only
# The app connects as `townmart_app` (cannot bypass RLS).
# In production add `?sslmode=require` (or verify-full) and point at PgBouncer.
DATABASE_URL=postgresql://townmart_app:app-dev-only@localhost:5432/townmart?schema=public
# Migrations and seeding run as `townmart_migrator` (owns the schema).
MIGRATE_DATABASE_URL=postgresql://townmart_migrator:migrator-dev-only@localhost:5432/townmart?schema=public

# ── Redis 7 (rate limits, locks, idempotency, BullMQ queues) ─────────────────
REDIS_URL=redis://localhost:6379

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-random-bytes
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Google OAuth (optional; the Google button is hidden when these are empty)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Column-level encryption (AES-256-GCM) and lookup hashing ─────────────────
# 32 random bytes, base64. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64
# Key id written next to each ciphertext so keys can be rotated (see scripts/db/rotate-keys.md)
DATA_ENCRYPTION_KEY_ID=k1
# Secret for deterministic HMAC lookup hashes (phone_hash, ip_hash). 32 random bytes, base64.
DATA_HASH_KEY=replace-me-with-32-random-bytes-base64

# ── Object storage (S3-compatible; MinIO locally) ────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=townmart
S3_SECRET_ACCESS_KEY=townmart-dev-only
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BUCKET=townmart-public
S3_PRIVATE_BUCKET=townmart-private
# Base URL used to serve public images (MinIO direct in dev; CDN in production)
S3_PUBLIC_BASE_URL=http://localhost:9000/townmart-public
MINIO_ROOT_USER=townmart
MINIO_ROOT_PASSWORD=townmart-dev-only

# ── Email ────────────────────────────────────────────────────────────────────
# smtp (Mailpit locally) or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="TownMart <no-reply@townmart.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# ── SMS / OTP (Termii) — used from Phase 1 onwards ───────────────────────────
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=TownMart

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
# Leave empty in development to skip the check. Test keys:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Payments — used from Phase 3 onwards ─────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# ── Dev seed ─────────────────────────────────────────────────────────────────
# Passwords for the seeded admin accounts. Printed to the console in development only.
SEED_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_PASSWORD=
