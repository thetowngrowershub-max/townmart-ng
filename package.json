{
  "name": "townmart",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "worker": "SERVICE_NAME=townmart-worker tsx worker/index.ts",
    "worker:dev": "SERVICE_NAME=townmart-worker tsx watch worker/index.ts",
    "db:bootstrap": "bash scripts/db/bootstrap.sh",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "ops:record": "tsx scripts/ops/record.ts",
    "load:oversell": "tsx scripts/load/oversell.ts",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@hookform/resolvers": "^6.0.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bullmq": "^6.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "framer-motion": "^14.6.0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^4.6.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.2.1",
    "pdf-lib": "1.17.1",
    "pino": "^10.4.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "^7.91.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.31",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "msgpackr-extract",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "next>postcss": "^8.5.31",
      "@prisma/config>deepmerge-ts": "^8.0.0"
    }
  }
}
