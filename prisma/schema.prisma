enum QuestionStatus {
  published
  hidden

  @@map("question_status")
}

/// Questions shoppers ask on a listing. Shown publicly once the seller answers.
model ListingQuestion {
  id          String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  productId   String?        @map("product_id") @db.Uuid
