/// Homepage banners, managed in the admin console.
model CmsBanner {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  title     String
  subtitle  String?
  imageKey  String?   @map("image_key")
  linkUrl   String?   @map("link_url")
  ctaLabel  String?   @map("cta_label")
  sortOrder Int       @default(0) @map("sort_order")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  isActive  Boolean   @default(true) @map("is_active")
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("cms_banners")
}

/// Stores shown in "Featured stores" on the homepage, in order.
model FeaturedStore {
  businessId String   @id @map("business_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("featured_stores")
}

/// Help centre questions and answers (/help).
model FaqEntry {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  section     String
  question    String
  answerHtml  String   @map("answer_html")
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([section, sortOrder])
  @@map("faq_entries")
}

/// Simple editable pages: about, contact.
model CmsPage {
  slug      String   @id
  title     String
  summary   String?
  bodyHtml  String   @map("body_html")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("cms_pages")
}

enum OpsEventKind {
  backup
  restore_test

  @@map("ops_event_kind")
}

/// Backups and restore drills, written by scripts/db (Phase 8) and shown on the health page.
model OpsEvent {
  id         String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  kind       OpsEventKind
  succeeded  Boolean
  startedAt  DateTime     @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime     @map("finished_at") @db.Timestamptz(6)
  sizeBytes  BigInt?      @map("size_bytes")
  details    Json?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([kind, finishedAt])
  @@map("ops_events")
}
