  @@index([status, dueAt])
  @@index([userId, createdAt])
  @@index([email])
  @@map("data_subject_requests")
}

enum RiskLevel {
  low
  medium
  high

  @@map("risk_level")
}

enum BreachStatus {
  open
  contained
  closed

  @@map("breach_status")
}

enum SubjectNoticeStatus {
  not_required
  pending
  sent

  @@map("subject_notice_status")
}

/// Personal data breach register. The NDPC must be told within 72 hours of awareness.
model BreachIncident {
  id                 String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  // BR-2026-0001
  reference          String              @unique
  title              String
  description        String
  detectedAt         DateTime            @map("detected_at") @db.Timestamptz(6)
  awareAt            DateTime            @map("aware_at") @db.Timestamptz(6)
  dataCategories     String[]            @map("data_categories")
  subjectsAffected   Int?                @map("subjects_affected")
  risk               RiskLevel
  actions            String?
  status             BreachStatus        @default(open)
  ndpcNotifiedAt     DateTime?           @map("ndpc_notified_at") @db.Timestamptz(6)
  ndpcReference      String?             @map("ndpc_reference")
  subjectNotice      SubjectNoticeStatus @default(pending) @map("subject_notice")
  subjectsNotifiedAt DateTime?           @map("subjects_notified_at") @db.Timestamptz(6)
  createdBy          String              @map("created_by") @db.Uuid
  closedAt           DateTime?           @map("closed_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, awareAt])
  @@map("breach_incidents")
}

enum LawfulBasis {
  consent
  contract
  legal_obligation
  vital_interests
  public_interest
  legitimate_interests

  @@map("lawful_basis")
}

/// Record of processing activities (RoPA).
model ProcessingActivity {
  id             String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name           String
  purpose        String
  lawfulBasis    LawfulBasis @map("lawful_basis")
  dataSubjects   String[]    @map("data_subjects")
  dataCategories String[]    @map("data_categories")
  recipients     String[]
  transfers      String?
  retention      String
  security       String?
  sortOrder      Int         @default(0) @map("sort_order")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  dpias DpiaRecord[]

  @@map("processing_activities")
}

/// Third parties that process personal data for TownMart.
model DataProcessor {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name           String    @unique
  service        String
  dataCategories String[]  @map("data_categories")
  // Where the data is processed, and the safeguard for transfers out of Nigeria.
  location       String
  safeguards     String?
  dpaSignedAt    DateTime? @map("dpa_signed_at") @db.Timestamptz(6)
  website        String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("data_processors")
}

enum DpiaStatus {
  draft
  approved
  needs_review

  @@map("dpia_status")
}

/// Data protection impact assessments.
model DpiaRecord {
