// TownMart database schema (PostgreSQL 16).
//
// Conventions (see DATABASE.md):
//   * snake_case tables and columns via @@map / @map
//   * UUID v7 primary keys generated in Postgres by uuid_generate_v7()
//   * timestamptz everywhere; updated_at is also maintained by a trigger
//   * money is BigInt kobo
// Things Prisma cannot express (RLS, triggers, check constraints, grants,
// partial indexes) live in the raw SQL sections of each migration. Postgres
// extensions (pgcrypto, citext, pg_trgm, btree_gist) are created by the first
// migration; pg_stat_statements by sql/bootstrap/roles.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATE_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  suspended
  pending_deletion
  anonymised

  @@map("user_status")
}

enum Role {
  customer
  merchant
  service_provider
  staff
  admin
  super_admin

  @@map("role")
}

enum OtpPurpose {
  sign_in
  verify_phone
  two_factor
  verify_business_phone

  @@map("otp_purpose")
}

model User {
  id                  String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email               String     @unique @db.Citext
  emailVerified       DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneEncrypted      String?    @map("phone_encrypted")
  phoneHash           String?    @unique @map("phone_hash")
  phoneVerifiedAt     DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  passwordHash        String?    @map("password_hash")
  name                String?
  image               String?    @map("avatar_url")
  status              UserStatus @default(active)
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  deletionRequestedAt DateTime?  @map("deletion_requested_at") @db.Timestamptz(6)
  // Sign-in with a password also asks for a code sent to the verified phone.
  twoFactorEnabledAt  DateTime?  @map("two_factor_enabled_at") @db.Timestamptz(6)
  anonymisedAt        DateTime?  @map("anonymised_at") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts  Account[]
  sessions  Session[]
  roles     UserRole[]
  otpCodes  OtpCode[]
  addresses Address[]

  ownedBusinesses      Business[]              @relation("BusinessOwner")
  promotionRedemptions PromotionRedemption[]
  staffOf              BusinessStaff[]
  carts                Cart[]
  orders               Order[]
  notifications        Notification[]
  bookings             Booking[]
  reviews              Review[]
  wishlistItems        WishlistItem[]
  policyAcceptances    PolicyAcceptance[]
  consentRecords       ConsentRecord[]
  notificationPrefs    NotificationPreference?
  dataRequests         DataSubjectRequest[]

  listingReports   ListingReport[]
  listingQuestions ListingQuestion[]

  @@index([status])
  @@map("users")
}

// Auth.js adapter tables. Field names are fixed by @auth/prisma-adapter.
model Account {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  userAgent    String?  @map("user_agent")
  ipHash       String?  @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

// Used by Auth.js and by TownMart's own email-verification and password-reset
// flows. `token` holds a SHA-256 hash of the emailed token, never the token.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

model UserRole {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model OtpCode {
  id        String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String?    @map("user_id") @db.Uuid
  phoneHash String?    @map("phone_hash")
  codeHash  String     @map("code_hash")
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(6)
  attempts  Int        @default(0)
  usedAt    DateTime?  @map("used_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phoneHash, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Address {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  label          String?
  recipientName  String   @map("recipient_name")
  phoneEncrypted String   @map("phone_encrypted")
  line1Encrypted String   @map("line1_encrypted")
  line2Encrypted String?  @map("line2_encrypted")
  city           String
  stateId        Int      @map("state_id") @db.SmallInt
  lgaId          Int      @map("lga_id") @db.SmallInt
  landmark       String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id], onDelete: Restrict)
  // Composite FK: the LGA must belong to the chosen state.
  lga   Lga   @relation(fields: [lgaId, stateId], references: [id, stateId], onDelete: Restrict, map: "addresses_lga_in_state")

  @@index([userId])
  @@index([stateId])
  @@index([lgaId, stateId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────────
// Reference data: 36 states + FCT and their 774 LGAs (seeded)
// ─────────────────────────────────────────────────────────────────────────────

model State {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  code      String   @unique @db.Char(2)
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  lgas       Lga[]
  addresses  Address[]
  businesses Business[]

  @@map("states")
}

model Lga {
  id        Int      @id @default(autoincrement()) @db.SmallInt
  stateId   Int      @map("state_id") @db.SmallInt
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  state      State      @relation(fields: [stateId], references: [id], onDelete: Restrict)
  addresses  Address[]
  businesses Business[]

  @@unique([stateId, slug])
  @@unique([id, stateId], map: "lgas_id_state_key")
  @@index([stateId])
  @@map("lgas")
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform settings, audit and operations
// ─────────────────────────────────────────────────────────────────────────────

model Setting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

// Append-only: UPDATE/DELETE are revoked from townmart_app and blocked by trigger.
// actor_user_id deliberately has no foreign key: audit rows must outlive (and
// never be rewritten by) user deletion or anonymisation.
model AuditLog {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   Role?    @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum JobRunStatus {
  running
  succeeded
  failed

  @@map("job_run_status")
}

model JobRun {
  id         String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  jobName    String       @map("job_name")
  status     JobRunStatus @default(running)
  startedAt  DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz(6)
  error      String?
  meta       Json?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([jobName, startedAt])
  @@index([startedAt])
  @@map("job_runs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sellers (Phase 1)
// ─────────────────────────────────────────────────────────────────────────────

enum BusinessType {
  retailer
  supermarket
  vendor
  merchant
  producer
  service_provider
  artisan

  @@map("business_type")
}

enum BusinessStatus {
  draft
  pending
  under_review
  approved
  rejected
  suspended

  @@map("business_status")
}

enum KycStatus {
  not_submitted
  pending
  verified
  failed

  @@map("kyc_status")
}

model Business {
  id                        String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerUserId               String         @map("owner_user_id") @db.Uuid
  type                      BusinessType
  name                      String
  slug                      String         @unique @db.Citext
  description               String?
  logoKey                   String?        @map("logo_key")
  bannerKey                 String?        @map("banner_key")
  cacNumber                 String?        @map("cac_number")
  email                     String         @db.Citext
  phoneEncrypted            String         @map("phone_encrypted")
  phoneHash                 String         @map("phone_hash")
  phoneVerifiedAt           DateTime?      @map("phone_verified_at") @db.Timestamptz(6)
  addressEncrypted          String         @map("address_encrypted")
  // Public, non-sensitive locality shown on listings ("Ikeja, Lagos").
  city                      String
  stateId                   Int            @map("state_id") @db.SmallInt
  lgaId                     Int            @map("lga_id") @db.SmallInt
  status                    BusinessStatus @default(draft)
  rejectionReason           String?        @map("rejection_reason")
  submittedAt               DateTime?      @map("submitted_at") @db.Timestamptz(6)
  reviewedAt                DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy                String?        @map("reviewed_by") @db.Uuid
  ratingAvg                 Decimal        @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount               Int            @default(0) @map("rating_count")
  sellsProducts             Boolean        @default(true) @map("sells_products")
  sellsServices             Boolean        @default(false) @map("sells_services")
  sellerAgreementVersion    String?        @map("seller_agreement_version")
  sellerAgreementAcceptedAt DateTime?      @map("seller_agreement_accepted_at") @db.Timestamptz(6)
  dpaVersion                String?        @map("dpa_version")
  dpaAcceptedAt             DateTime?      @map("dpa_accepted_at") @db.Timestamptz(6)
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           User               @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  state           State              @relation(fields: [stateId], references: [id], onDelete: Restrict)
  lga             Lga                @relation(fields: [lgaId, stateId], references: [id, stateId], onDelete: Restrict, map: "businesses_lga_in_state")
  staff           BusinessStaff[]
  kyc             BusinessKyc?
  payoutAccount   PayoutAccount?
  policy          StorePolicy?
  products        Product[]
  services        Service[]
  importJobs      ImportJob[]
  promotions      Promotion[]
  sellerOrders    SellerOrder[]
  cartItems       CartItem[]
  deliveryRates   DeliveryRate[]
  commissionRules CommissionRule[]
  bookings        Booking[]
  reviews         Review[]
  refunds         Refund[]
  disputes        Dispute[]
  payouts         Payout[]
  acceptances     PolicyAcceptance[]
  listingReports  ListingReport[]
  questions       ListingQuestion[]
  invitations     StaffInvitation[]
  featured        FeaturedStore?

  @@index([ownerUserId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "businesses_name_trgm")
  @@index([status, createdAt])
  @@index([stateId])
  @@index([lgaId, stateId])
  @@map("businesses")
}

model BusinessStaff {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  // e.g. { "inventory": true, "orders": false }
  permissions Json      @default("{}")
  invitedAt   DateTime  @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_staff")
}

// Raw BVN/NIN is never stored: only the provider's reference (encrypted) and status.
model BusinessKyc {
  id                         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  businessId                 String    @unique @map("business_id") @db.Uuid
  provider                   String    @default("manual")
  providerReferenceEncrypted String?   @map("provider_reference_encrypted")
  verificationStatus         KycStatus @default(not_submitted) @map("verification_status")
  idDocumentType             String?   @map("id_document_type")
  // Object keys in the PRIVATE bucket.
  documentKeys               String[]  @map("document_keys")
  verifiedAt                 DateTime? @map("verified_at") @db.Timestamptz(6)
  reviewedBy                 String?   @map("reviewed_by") @db.Uuid
  notes                      String?
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_kyc")
}

model PayoutAccount {
  id                     String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  businessId             String    @unique @map("business_id") @db.Uuid
  bankCode               String    @map("bank_code")
  bankName               String    @map("bank_name")
  accountNumberLast4     String    @map("account_number_last4") @db.Char(4)
  accountName            String    @map("account_name")
  providerSubaccountCode String?   @map("provider_subaccount_code")
  // Paystack transfer recipient for payouts (the full account number stays with Paystack).
  providerRecipientCode  String?   @map("provider_recipient_code")
  verifiedAt             DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

model StorePolicy {
  id                     String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  businessId             String   @unique @map("business_id") @db.Uuid
  returnWindowDays       Int      @default(7) @map("return_window_days") @db.SmallInt
  pickupAddressEncrypted String?  @map("pickup_address_encrypted")
  // { "delivery": true, "pickup": false, "notes": "..." }
  deliveryOptions        Json     @default("{\"delivery\": true, \"pickup\": false}") @map("delivery_options")
  acceptsPayOnDelivery   Boolean  @default(false) @map("accepts_pay_on_delivery")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("store_policies")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue (Phase 1)
// ─────────────────────────────────────────────────────────────────────────────

enum CategoryKind {
  product
  service

  @@map("category_kind")
}

enum ListingStatus {
  draft
  active
  archived

  @@map("listing_status")
}

enum UnitOfMeasure {
  piece
  kg
  litre
  crate
  bag
  pack

  @@map("unit_of_measure")
}

enum AttributeType {
  text
  number
  select

  @@map("attribute_type")
}

enum StockMovementReason {
  sale
  reservation
  release
  refund_restock
  manual_adjustment
  import

  @@map("stock_movement_reason")
}

enum PricingModel {
  fixed
  from
  hourly
  packages

  @@map("pricing_model")
}

enum LocationMode {
  on_site
  at_provider
  both

  @@map("location_mode")
}

model Category {
  id        String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  parentId  String?      @map("parent_id") @db.Uuid
  name      String
  slug      String       @unique
  kind      CategoryKind
  icon      String?
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  products   Product[]
  services   Service[]

  promotionTargets PromotionTarget[]
  commissionRules  CommissionRule[]

  @@index([parentId, sortOrder])
  @@index([kind, isActive])
  @@map("categories")
}

model Attribute {
  id        String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String
  slug      String        @unique
  type      AttributeType @default(text)
  options   String[]
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  categories CategoryAttribute[]

  @@map("attributes")
}

model CategoryAttribute {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  isRequired  Boolean  @default(false) @map("is_required")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@index([attributeId])
  @@map("category_attributes")
}

model Product {
  id                 String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  businessId         String                   @map("business_id") @db.Uuid
  categoryId         String                   @map("category_id") @db.Uuid
  title              String
  slug               String                   @unique @db.Citext
  descriptionHtml    String                   @default("") @map("description_html")
  brand              String?
  tags               String[]
  // Values for the category's custom attributes: { "<attribute slug>": value }
  attributes         Json                     @default("{}")
  basePriceKobo      BigInt                   @map("base_price_kobo")
  compareAtPriceKobo BigInt?                  @map("compare_at_price_kobo")
  costPriceKobo      BigInt?                  @map("cost_price_kobo")
  unit               UnitOfMeasure            @default(piece)
  minOrderQty        Decimal                  @default(1) @map("min_order_qty") @db.Decimal(12, 3)
  allowFractionalQty Boolean                  @default(false) @map("allow_fractional_qty")
  trackInventory     Boolean                  @default(true) @map("track_inventory")
  allowBackorder     Boolean                  @default(false) @map("allow_backorder")
  weightGrams        Int?                     @map("weight_grams")
  // { "lengthCm": 10, "widthCm": 5, "heightCm": 2 }
  dimensions         Json?
  isPerishable       Boolean                  @default(false) @map("is_perishable")
  shelfLifeNote      String?                  @map("shelf_life_note")
  status             ListingStatus            @default(draft)
  metaTitle          String?                  @map("meta_title")
  metaDescription    String?                  @map("meta_description")
  // Maintained by trigger (see migration); GIN-indexed.
  searchVector       Unsupported("tsvector")? @map("search_vector")
  ratingAvg          Decimal                  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                      @default(0) @map("rating_count")
  publishedAt        DateTime?                @map("published_at") @db.Timestamptz(6)
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz(6)
  // Taken down by TownMart (moderation): hidden everywhere until restored. Only TownMart can set these.
  takenDownAt        DateTime?                @map("taken_down_at") @db.Timestamptz(6)
  takenDownReason    String?                  @map("taken_down_reason")
  takenDownBy        String?                  @map("taken_down_by") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business      Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  options       ProductOption[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  reports       ListingReport[]
  questions     ListingQuestion[]

  promotionTargets PromotionTarget[]

  @@unique([id, businessId], map: "products_id_business_key")
  @@index([searchVector], type: Gin, map: "products_search_vector_gin")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_trgm")
  @@index([businessId, status, createdAt])
  @@index([categoryId])
  @@map("products")
}

