// ─────────────────────────────────────────────────────────────────────────────
// Promotions (Phase 2)
// ─────────────────────────────────────────────────────────────────────────────

enum DiscountType {
  percentage
  fixed

  @@map("discount_type")
}

enum PromotionScope {
  product
  products
  category
  store
  service

  @@map("promotion_scope")
}

/// A discount rule. business_id NULL = platform-wide (admin only).
/// percentage: discount_value is whole percent (1-100); fixed: kobo off each unit.
model Promotion {
  id               String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  businessId       String?        @map("business_id") @db.Uuid
  name             String
  description      String?
  discountType     DiscountType   @map("discount_type")
  discountValue    BigInt         @map("discount_value")
  scope            PromotionScope
  startsAt         DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime       @map("ends_at") @db.Timestamptz(6)
  usageLimit       Int?           @map("usage_limit")
  perCustomerLimit Int?           @map("per_customer_limit")
  minOrderKobo     BigInt         @default(0) @map("min_order_kobo")
  isFlashDeal      Boolean        @default(false) @map("is_flash_deal")
  isActive         Boolean        @default(true) @map("is_active")
  // Maintained by triggers: whether a coupon code is required, and how many times it has been used.
  hasCoupon        Boolean        @default(false) @map("has_coupon")
  redemptionCount  Int            @default(0) @map("redemption_count")
  createdBy        String?        @map("created_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  targets     PromotionTarget[]
  coupon      Coupon?
  redemptions PromotionRedemption[]

  @@index([businessId, endsAt])
  @@index([startsAt, endsAt], map: "promotions_live_idx")
  @@map("promotions")
}

/// What a product/products/category/service promotion covers: exactly one of the three ids.
model PromotionTarget {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  businessId  String?  @map("business_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade, map: "promotion_targets_product_same_business")
  service   Service?  @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade, map: "promotion_targets_service_same_business")
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([productId, businessId])
  @@index([serviceId, businessId])
  @@index([categoryId])
  @@map("promotion_targets")
}

/// An optional code that unlocks a promotion. The code is private to the seller and TownMart.
model Coupon {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  promotionId    String   @unique @map("promotion_id") @db.Uuid
  businessId     String?  @map("business_id") @db.Uuid
  code           String   @unique @db.Citext
  allowsStacking Boolean  @default(false) @map("allows_stacking")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  promotion   Promotion             @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  redemptions PromotionRedemption[]

  @@index([businessId])
  @@map("coupons")
}

/// One row per order that used a promotion. Written by checkout (Phase 3); append-only.
model PromotionRedemption {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  promotionId  String   @map("promotion_id") @db.Uuid
  couponId     String?  @map("coupon_id") @db.Uuid
  businessId   String?  @map("business_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  discountKobo BigInt   @map("discount_kobo")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  coupon    Coupon?   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([promotionId, orderId])
  @@index([orderId])
  @@index([couponId])
  @@index([userId, promotionId])
  @@index([businessId, createdAt])
  @@map("promotion_redemptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cart, checkout and payments (Phase 3)
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  pending_payment
  paid
  processing
  ready_for_pickup
  shipped
  delivered
  completed
  cancelled
  refund_requested
  refunded
  partially_refunded

  @@map("order_status")
}

enum OrderPaymentStatus {
  unpaid
  paid
  failed
  pay_on_delivery
  refunded
  partially_refunded

  @@map("order_payment_status")
}

enum PaymentProviderName {
  paystack
  flutterwave
  pay_on_delivery
  // Development only: a local stand-in for a card payment page.
  fake

  @@map("payment_provider")
}

enum PaymentState {
  initiated
  success
  failed
  abandoned
  reversed

  @@map("payment_state")
}

enum ReservationStatus {
  held
  converted
  released

  @@map("reservation_status")
}

enum DeliveryMethod {
  delivery
  pickup
  // A seller order with only bookings: nothing to deliver.
  none

  @@map("delivery_method")
}

enum CommissionScope {
  global
  category
  business

  @@map("commission_scope")
}

enum LedgerOwnerType {
  platform
  business
  customer
  provider_clearing

  @@map("ledger_owner_type")
}

enum LedgerAccountType {
  escrow
  available
  commission
  refunds
  fees
  tax
  promotions
  clearing

  @@map("ledger_account_type")
}

// A signed-in shopper has one cart; a guest's cart is found by the hash of a
// random token in a signed cookie, and merged into their own cart on sign-in.
model Cart {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  guestTokenHash String?  @unique @map("guest_token_hash")
  couponCode     String?  @map("coupon_code") @db.Citext
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([expiresAt])
  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  cartId          String    @map("cart_id") @db.Uuid
  // A product variant, or a service booking (service, optional package and a start time).
  variantId       String?   @map("variant_id") @db.Uuid
  serviceId       String?   @map("service_id") @db.Uuid
  packageId       String?   @map("package_id") @db.Uuid
  bookingStartsAt DateTime? @map("booking_starts_at") @db.Timestamptz(6)
  // For services offered both ways: the shopper goes to the provider.
  atProvider      Boolean   @default(false) @map("at_provider")
  businessId      String    @map("business_id") @db.Uuid
  qty             Decimal   @db.Decimal(12, 3)
  savedForLater   Boolean   @default(false) @map("saved_for_later")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart     Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Cascade)
  service  Service?        @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)
  package  ServicePackage? @relation(fields: [packageId], references: [id], onDelete: Cascade)
  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId, businessId])
  @@index([serviceId, businessId])
  @@index([packageId])
  @@index([businessId])
  @@map("cart_items")
}

// Stock is taken off the variant when the order is placed (a "reservation"
// stock movement) and given back if payment doesn't arrive in time.
model StockReservation {
  id            String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  variantId     String            @map("variant_id") @db.Uuid
  businessId    String            @map("business_id") @db.Uuid
  orderId       String            @map("order_id") @db.Uuid
  sellerOrderId String            @map("seller_order_id") @db.Uuid
  qty           Decimal           @db.Decimal(12, 3)
  status        ReservationStatus @default(held)
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant     ProductVariant @relation(fields: [variantId, businessId], references: [id, businessId], onDelete: Restrict)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder    @relation(fields: [sellerOrderId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId, businessId])
  @@index([sellerOrderId, businessId])
  @@map("stock_reservations")
}

model Order {
  id                      String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  // TM-2026-000123
  orderNumber             String              @unique @map("order_number")
  userId                  String?             @map("user_id") @db.Uuid
  // Where the receipt goes: the account email, or the guest's email.
  contactEmail            String              @map("contact_email") @db.Citext
  contactPhoneEncrypted   String              @map("contact_phone_encrypted")
  customerName            String              @map("customer_name")
  isGuest                 Boolean             @default(false) @map("is_guest")
  // Recipient, state/LGA names and ids; street lines and phone are encrypted.
  shippingAddressSnapshot Json                @map("shipping_address_snapshot")
  subtotalKobo            BigInt              @map("subtotal_kobo")
  discountKobo            BigInt              @map("discount_kobo")
  deliveryKobo            BigInt              @map("delivery_kobo")
  serviceFeeKobo          BigInt              @map("service_fee_kobo")
  vatKobo                 BigInt              @map("vat_kobo")
  // Due at checkout (online, or on delivery). Booking balances paid to the provider on the day are payLaterKobo.
  totalKobo               BigInt              @map("total_kobo")
  payLaterKobo            BigInt              @default(0) @map("pay_later_kobo")
  paymentStatus           OrderPaymentStatus  @default(unpaid) @map("payment_status")
  paymentMethod           PaymentProviderName @map("payment_method")
  couponCode              String?             @map("coupon_code") @db.Citext
  // Promotion uses to record when payment is confirmed: [{ promotionId, couponId, discountKobo }]
  promotionPlan           Json                @default("[]") @map("promotion_plan")
  termsVersion            String              @map("terms_version")
  refundPolicyVersion     String              @map("refund_policy_version")
  marketingConsent        Boolean             @default(false) @map("marketing_consent")
  // A guest opens their order with a link carrying a random token; only its hash is stored.
  accessTokenHash         String              @map("access_token_hash")
  ipHash                  String?             @map("ip_hash")
  placedAt                DateTime            @default(now()) @map("placed_at") @db.Timestamptz(6)
  paymentDueAt            DateTime?           @map("payment_due_at") @db.Timestamptz(6)
  paidAt                  DateTime?           @map("paid_at") @db.Timestamptz(6)
  cancelledAt             DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelReason            String?             @map("cancel_reason")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  sellerOrders SellerOrder[]
  payments     Payment[]
  reservations StockReservation[]
  redemptions  PromotionRedemption[]
  refunds      Refund[]
  acceptances  PolicyAcceptance[]

  @@index([userId, placedAt])
  @@index([paymentStatus, paymentDueAt])
  @@map("orders")
}

model SellerOrder {
  id                   String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId              String         @map("order_id") @db.Uuid
  businessId           String         @map("business_id") @db.Uuid
  // Copied from the order: sellers can't read the order row (it holds other sellers' totals).
  orderNumber          String         @map("order_number")
  payOnDelivery        Boolean        @default(false) @map("pay_on_delivery")
  status               OrderStatus    @default(pending_payment)
  subtotalKobo         BigInt         @map("subtotal_kobo")
  // All discounts on this seller's items; platformDiscountKobo is the part TownMart pays for.
  discountKobo         BigInt         @map("discount_kobo")
  platformDiscountKobo BigInt         @default(0) @map("platform_discount_kobo")
  deliveryKobo         BigInt         @map("delivery_kobo")
  commissionKobo       BigInt         @map("commission_kobo")
  sellerNetKobo        BigInt         @map("seller_net_kobo")
  // Booking balances the customer pays this seller directly on the day.
  payLaterKobo         BigInt         @default(0) @map("pay_later_kobo")
  deliveryMethod       DeliveryMethod @map("delivery_method")
  // What the seller needs to fulfil this part, and nothing more: recipient
  // name, phone and (for delivery or on-site services) the address. Phone and
  // street lines stay encrypted.
  fulfilmentContact    Json?          @map("fulfilment_contact")
  etaDaysMin           Int?           @map("eta_days_min") @db.SmallInt
  etaDaysMax           Int?           @map("eta_days_max") @db.SmallInt
  trackingNumber       String?        @map("tracking_number")
  carrier              String?
  shippedAt            DateTime?      @map("shipped_at") @db.Timestamptz(6)
  deliveredAt          DateTime?      @map("delivered_at") @db.Timestamptz(6)
  completedAt          DateTime?      @map("completed_at") @db.Timestamptz(6)
  // Pay on delivery: when the seller confirmed they were paid.
  cashCollectedAt      DateTime?      @map("cash_collected_at") @db.Timestamptz(6)
  escrowReleaseAt      DateTime?      @map("escrow_release_at") @db.Timestamptz(6)
  // When the seller's share moved from escrow to their available balance (paid
  // online), or when TownMart's commission was settled (pay on delivery).
  escrowReleasedAt     DateTime?      @map("escrow_released_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reservations  StockReservation[]
  bookings      Booking[]
  messages      Message[]
  refunds       Refund[]
  disputes      Dispute[]

  @@unique([orderId, businessId])
  @@unique([id, businessId], map: "seller_orders_id_business_key")
  @@index([businessId, status, createdAt])
  @@map("seller_orders")
}

model OrderItem {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sellerOrderId String   @map("seller_order_id") @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  variantId     String?  @map("variant_id") @db.Uuid
  productId     String?  @map("product_id") @db.Uuid
  serviceId     String?  @map("service_id") @db.Uuid
  packageId     String?  @map("package_id") @db.Uuid
  // { title, slug, sku, options, image, unit } at the time of the order
  snapshot      Json
  unitPriceKobo BigInt   @map("unit_price_kobo")
  qty           Decimal  @db.Decimal(12, 3)
  subtotalKobo  BigInt   @map("subtotal_kobo")
  discountKobo  BigInt   @map("discount_kobo")
  lineTotalKobo BigInt   @map("line_total_kobo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sellerOrder SellerOrder     @relation(fields: [sellerOrderId, businessId], references: [id, businessId], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  booking     Booking?
  review      Review?
  refundItems RefundItem[]

  @@unique([id, businessId], map: "order_items_id_business_key")
  @@index([sellerOrderId, businessId])
  @@index([variantId])
  @@index([productId])
  @@index([serviceId])
  @@map("order_items")
}

// Append-only: UPDATE/DELETE are revoked from townmart_app.
model OrderStatusHistory {
  id            String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sellerOrderId String       @map("seller_order_id") @db.Uuid
  businessId    String       @map("business_id") @db.Uuid
  fromStatus    OrderStatus? @map("from_status")
  toStatus      OrderStatus  @map("to_status")
  actorUserId   String?      @map("actor_user_id") @db.Uuid
  note          String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([sellerOrderId, businessId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId           String              @map("order_id") @db.Uuid
  provider          PaymentProviderName
  providerReference String              @unique @map("provider_reference")
  amountKobo        BigInt              @map("amount_kobo")
  status            PaymentState        @default(initiated)
  channel           String?
  paidAt            DateTime?           @map("paid_at") @db.Timestamptz(6)
  // The provider's verification response (no card data is ever sent to us).
  rawVerification   Json?               @map("raw_verification")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

// Every webhook delivery, valid or not. The unique key makes a repeated
// delivery a no-op.
model PaymentEvent {
  id              String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider        PaymentProviderName
  eventType       String              @map("event_type")
  providerEventId String              @map("provider_event_id")
  reference       String?
  signatureValid  Boolean             @map("signature_valid")
  payload         Json
  processedAt     DateTime?           @map("processed_at") @db.Timestamptz(6)
  error           String?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([reference])
  @@map("payment_events")
}

model CommissionRule {
  id            String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  scope         CommissionScope
  categoryId    String?         @map("category_id") @db.Uuid
  businessId    String?         @map("business_id") @db.Uuid
  // Basis points: 500 = 5%.
  percentBps    Int             @map("percent_bps")
  fixedKobo     BigInt          @default(0) @map("fixed_kobo")
  effectiveFrom DateTime        @default(now()) @map("effective_from") @db.Timestamptz(6)
  createdBy     String?         @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([scope, effectiveFrom])
  @@index([categoryId])
  @@index([businessId])
  @@map("commission_rules")
}

// Destination zones for delivery fees. An address matches a zone by LGA first,
// then by state; the zone with the lowest priority number wins.
model DeliveryZone {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String
  slug      String   @unique
  stateIds  Int[]    @map("state_ids") @db.SmallInt
  lgaIds    Int[]    @map("lga_ids") @db.SmallInt
  priority  Int      @default(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates DeliveryRate[]

  @@index([stateIds], type: Gin, map: "delivery_zones_states")
  @@index([lgaIds], type: Gin, map: "delivery_zones_lgas")
  @@map("delivery_zones")
}

// A seller's own rate (business_id set) replaces TownMart's default for that zone.
model DeliveryRate {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  zoneId       String   @map("zone_id") @db.Uuid
  businessId   String?  @map("business_id") @db.Uuid
  minWeightG   Int      @default(0) @map("min_weight_g")
  // NULL = no upper limit.
  maxWeightG   Int?     @map("max_weight_g")
  feeKobo      BigInt   @map("fee_kobo")
  freeOverKobo BigInt?  @map("free_over_kobo")
  etaDaysMin   Int      @map("eta_days_min") @db.SmallInt
  etaDaysMax   Int      @map("eta_days_max") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone     DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  business Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([zoneId, businessId, minWeightG])
  @@index([businessId])
  @@map("delivery_rates")
}

// ── Double-entry ledger (append-only) ────────────────────────────────────────
model LedgerAccount {
  id        String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerType LedgerOwnerType   @map("owner_type")
  // The business id for business accounts, NULL otherwise (used by RLS).
  // owner_key identifies the owner within its type: the business id, the
  // payment provider's name for clearing accounts, or "" for the platform.
  ownerId   String?           @map("owner_id") @db.Uuid
  ownerKey  String            @default("") @map("owner_key")
  type      LedgerAccountType
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  entries LedgerEntry[]

  @@unique([ownerType, ownerKey, type])
  @@index([ownerId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  kind          String
  referenceType String   @map("reference_type")
  referenceId   String   @map("reference_id") @db.Uuid
  memo          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entries LedgerEntry[]

  @@unique([kind, referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  // Copied from the account (business accounts only), for RLS.
  businessId    String?  @map("business_id") @db.Uuid
  debitKobo     BigInt   @default(0) @map("debit_kobo")
  creditKobo    BigInt   @default(0) @map("credit_kobo")
  referenceType String   @map("reference_type")
  referenceId   String   @map("reference_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt])
  @@index([businessId, createdAt])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

// In-app notifications (the bell). Email and SMS go through the worker queue.
model Notification {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// ── Phase 4: fulfilment and services ─────────────────────────────────────────

enum BookingStatus {
  // Slot taken while the customer pays (online payment only).
  held
  // Paid (or pay later); waiting for the provider to accept.
  requested
  confirmed
  in_progress
  completed
  cancelled
  no_show
  // Moved to another time: the new time is a new booking pointing back at this one.
  rescheduled

  @@map("booking_status")
}

/// A service booking. The exclusion constraint `bookings_no_overlap` (raw SQL)
/// stops two active bookings of the same service sharing a capacity slot at
/// overlapping times, so a time can't be booked beyond its capacity.
model Booking {
  id               String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  sellerOrderId    String        @map("seller_order_id") @db.Uuid
  orderItemId      String        @unique @map("order_item_id") @db.Uuid
  businessId       String        @map("business_id") @db.Uuid
  serviceId        String        @map("service_id") @db.Uuid
  packageId        String?       @map("package_id") @db.Uuid
  customerUserId   String?       @map("customer_user_id") @db.Uuid
  startsAt         DateTime      @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime      @map("ends_at") @db.Timestamptz(6)
  // Which of the time's capacity places this booking holds (1..max per slot).
  slotNo           Int           @default(1) @map("slot_no") @db.SmallInt
  capacity         Int           @default(1) @db.SmallInt
  status           BookingStatus @default(held)
  atProvider       Boolean       @default(false) @map("at_provider")
  // Where the service happens: the customer's address (on site) or the provider's area.
  locationSnapshot Json          @map("location_snapshot")
  priceKobo        BigInt        @map("price_kobo")
  depositKobo      BigInt        @default(0) @map("deposit_kobo")
  balanceKobo      BigInt        @default(0) @map("balance_kobo")
  holdExpiresAt    DateTime?     @map("hold_expires_at") @db.Timestamptz(6)
  // When the booking was last moved: the time it had before.
  previousStartsAt DateTime?     @map("previous_starts_at") @db.Timestamptz(6)
  cancelReason     String?       @map("cancel_reason")
  reminder24SentAt DateTime?     @map("reminder_24_sent_at") @db.Timestamptz(6)
  reminder1SentAt  DateTime?     @map("reminder_1_sent_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sellerOrder   SellerOrder            @relation(fields: [sellerOrderId, businessId], references: [id, businessId], onDelete: Cascade)
  orderItem     OrderItem              @relation(fields: [orderItemId, businessId], references: [id, businessId], onDelete: Cascade)
  service       Service                @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict)
  package       ServicePackage?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  business      Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer      User?                  @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  statusHistory BookingStatusHistory[]
  review        Review?

  @@unique([orderItemId, businessId])
  @@unique([id, businessId], map: "bookings_id_business_key")
  @@index([sellerOrderId, businessId])
  @@index([orderId])
  @@index([serviceId, businessId, startsAt])
  @@index([packageId])
  @@index([businessId, status, startsAt])
  @@index([customerUserId, startsAt])
  @@index([status, startsAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id          String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  businessId  String         @map("business_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([bookingId, businessId, createdAt])
  @@map("booking_status_history")
}

enum MessageSender {
  customer
  seller
  system

  @@map("message_sender")
}

/// One conversation per seller order, between the customer and the seller.
model Message {
  id            String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sellerOrderId String        @map("seller_order_id") @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  senderUserId  String?       @map("sender_user_id") @db.Uuid
  sender        MessageSender
  body          String
  // When the other side read it.
  readAt        DateTime?     @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([sellerOrderId, businessId, createdAt])
  @@index([businessId, createdAt])
  @@map("messages")
}

enum ReviewTarget {
  product
  service

  @@map("review_target")
}

enum ReviewStatus {
  published
  // Reported by someone: still shown until a moderator decides.
  reported
  hidden

  @@map("review_status")
}

/// Verified reviews only: each is tied to the order item (product) or the
/// completed booking (service) it reviews, one review per purchase.
model Review {
  id              String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  targetType      ReviewTarget @map("target_type")
  productId       String?      @map("product_id") @db.Uuid
  serviceId       String?      @map("service_id") @db.Uuid
  businessId      String       @map("business_id") @db.Uuid
  orderItemId     String?      @unique @map("order_item_id") @db.Uuid
  bookingId       String?      @unique @map("booking_id") @db.Uuid
  userId          String?      @map("user_id") @db.Uuid
  // Shown publicly instead of the full name: "Ada O."
  authorName      String       @map("author_name")
  rating          Int          @db.SmallInt
  body            String
  imageKeys       String[]     @default([]) @map("image_keys")
  status          ReviewStatus @default(published)
  sellerReply     String?      @map("seller_reply")
  sellerRepliedAt DateTime?    @map("seller_replied_at") @db.Timestamptz(6)
  reportReason    String?      @map("report_reason")
  reportedAt      DateTime?    @map("reported_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  service   Service?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([serviceId, status, createdAt])
  @@index([businessId, createdAt])
  @@index([userId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  serviceId String?  @map("service_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, serviceId])
  @@index([productId])
  @@index([serviceId])
  @@map("wishlist_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Refunds, disputes and payouts (Phase 5)
// ─────────────────────────────────────────────────────────────────────────────

enum RefundStatus {
  // Waiting for the seller (or TownMart) to decide.
  requested
  // Decided; the money is owed to the customer and goes back through the provider.
  approved
  rejected
  // Sent to the payment provider, which is still working on it.
  processing
  completed
  // The provider refused or errored; TownMart retries from the admin console.
  failed

  @@map("refund_status")
}

enum RefundReason {
  cancelled_by_customer
  cancelled_by_seller
  booking_cancelled
  not_received
  damaged
  wrong_item
  not_as_described
  changed_mind
  provider_no_show
  // A payment TownMart couldn't use: paid twice, the wrong amount, or after the items sold out.
  payment_problem
  other

  @@map("refund_reason")
}

enum RefundOrigin {
  customer
  seller
  admin
  system

  @@map("refund_origin")
}

/// Money going back to a customer. Goods refunds belong to one seller order;
/// payment-problem refunds (seller_order_id NULL) return a whole payment.
/// The ledger is written when a refund is approved (the seller's share and
/// TownMart's commission come back into "refunds payable") and again when the
/// provider has paid it out.
model Refund {
  id                           String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  // RF-2026-000123
  refundNumber                 String             @unique @map("refund_number")
  orderId                      String             @map("order_id") @db.Uuid
  sellerOrderId                String?            @map("seller_order_id") @db.Uuid
  businessId                   String?            @map("business_id") @db.Uuid
  paymentId                    String             @map("payment_id") @db.Uuid
  origin                       RefundOrigin
  requestedBy                  String?            @map("requested_by") @db.Uuid
  reason                       RefundReason
  details                      String?
  // Private photos, read through /api/refunds/:id/evidence/:n.
  evidenceKeys                 String[]           @default([]) @map("evidence_keys")
  // What the customer asked for (goods and delivery), and what was approved.
  requestedKobo                BigInt             @map("requested_kobo")
  amountKobo                   BigInt             @map("amount_kobo")
  // TownMart's service fee and its VAT, refunded with the last refund that empties an order.
  feeKobo                      BigInt             @default(0) @map("fee_kobo")
  vatKobo                      BigInt             @default(0) @map("vat_kobo")
  // How the approved amount splits, fixed at approval (see lib/refunds/math.ts).
  commissionReturnedKobo       BigInt             @default(0) @map("commission_returned_kobo")
  platformDiscountReturnedKobo BigInt             @default(0) @map("platform_discount_returned_kobo")
  sellerDebitKobo              BigInt             @default(0) @map("seller_debit_kobo")
  // Which of the seller's balances paid for it: escrow before release, available after.
  debitedFrom                  LedgerAccountType? @map("debited_from")
  includesDelivery             Boolean            @default(false) @map("includes_delivery")
  status                       RefundStatus       @default(requested)
  // The seller's (or TownMart's) note on the decision.
  response                     String?
  // The seller must answer by then, or the request goes to TownMart.
  respondBy                    DateTime?          @map("respond_by") @db.Timestamptz(6)
  decidedBy                    String?            @map("decided_by") @db.Uuid
  decidedAt                    DateTime?          @map("decided_at") @db.Timestamptz(6)
  providerRefundReference      String?            @map("provider_refund_reference")
  providerStatus               String?            @map("provider_status")
  attempts                     Int                @default(0)
  lastError                    String?            @map("last_error")
  sentAt                       DateTime?          @map("sent_at") @db.Timestamptz(6)
  completedAt                  DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt                    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items       RefundItem[]
  dispute     Dispute?

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([businessId, status, createdAt])
  @@index([status, respondBy])
  @@index([paymentId])
  @@map("refunds")
}

model RefundItem {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  refundId    String    @map("refund_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  qty         Decimal   @db.Decimal(12, 3)
  amountKobo  BigInt    @map("amount_kobo")
  // Goods that came back (or never left) go back on sale.
  restock     Boolean   @default(false)
  restockedAt DateTime? @map("restocked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId, businessId], references: [id, businessId], onDelete: Restrict)

  @@unique([refundId, orderItemId])
  @@index([orderItemId, businessId])
  @@map("refund_items")
}

enum DisputeStatus {
  open
  resolved
  // Withdrawn by the customer.
  closed

  @@map("dispute_status")
}

enum DisputeOutcome {
  refund_full
  refund_partial
  no_refund
  withdrawn

  @@map("dispute_outcome")
}

enum DisputeParty {
  customer
  seller
  admin
  system

  @@map("dispute_party")
}

/// A disagreement TownMart decides: a refund the seller turned down or
/// didn't answer in time, or a problem the customer raised. Escrow for the
/// seller order is held while it's open.
model Dispute {
  id             String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  sellerOrderId  String          @map("seller_order_id") @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  refundId       String?         @unique @map("refund_id") @db.Uuid
  openedBy       String?         @map("opened_by") @db.Uuid
  openedByParty  DisputeParty    @map("opened_by_party")
  reason         String
  status         DisputeStatus   @default(open)
  outcome        DisputeOutcome?
  resolutionNote String?         @map("resolution_note")
  resolvedBy     String?         @map("resolved_by") @db.Uuid
  resolvedAt     DateTime?       @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sellerOrder SellerOrder      @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  refund      Refund?          @relation(fields: [refundId], references: [id], onDelete: Restrict)
  messages    DisputeMessage[]

  @@index([status, createdAt])
  @@index([sellerOrderId])
  @@index([businessId, status])
  @@index([orderId])
  @@map("disputes")
}

/// Append-only: the customer, the seller and TownMart all see the whole thread.
model DisputeMessage {
  id           String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  disputeId    String       @map("dispute_id") @db.Uuid
  businessId   String       @map("business_id") @db.Uuid
  sender       DisputeParty
  senderUserId String?      @map("sender_user_id") @db.Uuid
  body         String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

enum PayoutStatus {
  // Written to the ledger; the transfer hasn't been sent yet.
  pending
  // Sent; waiting for the provider to confirm.
  processing
  paid
  // The transfer failed and the money went back to the seller's available balance.
  failed

  @@map("payout_status")
}

/// A transfer of a seller's available balance to their bank account.
model Payout {
  id                   String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  businessId           String       @map("business_id") @db.Uuid
  amountKobo           BigInt       @map("amount_kobo")
  status               PayoutStatus @default(pending)
  provider             String
  // Our reference, sent to the provider (idempotency key for the transfer).
  reference            String       @unique
  providerTransferCode String?      @map("provider_transfer_code")
  // Where it went, as it was then.
  bankName             String       @map("bank_name")
  accountNumberLast4   String       @map("account_number_last4") @db.Char(4)
  accountName          String       @map("account_name")
  periodStart          DateTime     @map("period_start") @db.Timestamptz(6)
  periodEnd            DateTime     @map("period_end") @db.Timestamptz(6)
  // NULL for the scheduled run.
  requestedBy          String?      @map("requested_by") @db.Uuid
  failureReason        String?      @map("failure_reason")
  sentAt               DateTime?    @map("sent_at") @db.Timestamptz(6)
  paidAt               DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@map("payouts")
}

// ── Phase 6: compliance and legal ────────────────────────────────────────────

/// One published version of a legal page. A new version is a new row; old
/// versions stay so every acceptance points at the exact text accepted.
model LegalDocument {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  slug        String
  // "2026-10-draft", then the effective date of each new version ("2026-11-14").
  version     String
  title       String
  summary     String
  // Sanitised HTML; {{company.*}} placeholders are filled in from settings when shown.
  bodyHtml    String   @map("body_html")
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(6)
  // Generated or unreviewed text carries the "review with a Nigerian lawyer/DPO" notice.
  isTemplate  Boolean  @default(true) @map("is_template")
  changeNote  String?  @map("change_note")
  publishedBy String?  @map("published_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  acceptances PolicyAcceptance[]

  @@unique([slug, version])
  @@index([slug, effectiveAt])
  @@map("legal_documents")
}

enum AcceptanceContext {
  sign_up
  checkout
  seller_onboarding

  @@map("acceptance_context")
}

/// Proof that someone accepted a version of a legal document. Append-only.
model PolicyAcceptance {
  id         String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  documentId String            @map("document_id") @db.Uuid
  context    AcceptanceContext
  userId     String?           @map("user_id") @db.Uuid
  orderId    String?           @map("order_id") @db.Uuid
  businessId String?           @map("business_id") @db.Uuid
  ipHash     String?           @map("ip_hash")
  userAgent  String?           @map("user_agent")
  acceptedAt DateTime          @default(now()) @map("accepted_at") @db.Timestamptz(6)

  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  business Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([userId, acceptedAt])
  @@index([orderId])
  @@index([businessId])
  @@index([documentId])
  @@map("policy_acceptances")
}

/// Every cookie choice, as made. Append-only; the latest row per subject is the current choice.
model ConsentRecord {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  // Random id kept in the consent cookie, so choices made before sign-in can be found.
  subjectId     String   @map("subject_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  // Necessary cookies are always on and not recorded as a choice.
  functional    Boolean
  analytics     Boolean
  marketing     Boolean
  policyVersion String   @map("policy_version")
  // banner, settings (footer link) or privacy_centre
  source        String
  ipHash        String?  @map("ip_hash")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([subjectId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("consent_records")
}

/// What a signed-in user wants to hear about. Transactional emails (receipts,
/// refunds, security) always go; these switch off the optional channels.
model NotificationPreference {
  userId              String    @id @map("user_id") @db.Uuid
  smsOrderUpdates     Boolean   @default(true) @map("sms_order_updates")
  smsBookingReminders Boolean   @default(true) @map("sms_booking_reminders")
  emailMessages       Boolean   @default(true) @map("email_messages")
  // Marketing is opt-in, separate from the terms.
  marketingEmail      Boolean   @default(false) @map("marketing_email")
  marketingEmailAt    DateTime? @map("marketing_email_at") @db.Timestamptz(6)
  marketingSms        Boolean   @default(false) @map("marketing_sms")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Addresses that used a one-click unsubscribe link (guests included). Never sent marketing again.
model MarketingSuppression {
  email     String   @id @db.Citext
  source    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("marketing_suppressions")
}

enum DsrType {
