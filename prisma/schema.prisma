  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service   Service    @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)
  cartItems CartItem[]
  bookings  Booking[]

  @@index([serviceId, businessId, position])
  @@index([businessId])
  @@map("service_packages")
}

model ServiceImage {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  storageKey String   @map("storage_key")
  altText    String   @map("alt_text")
  width      Int
  height     Int
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([serviceId, businessId, sortOrder])
  @@index([businessId])
  @@map("service_images")
}

// Weekly opening hours. Times are minutes after midnight, Africa/Lagos.
model ServiceAvailability {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  // 0 = Sunday … 6 = Saturday
  weekday       Int      @db.SmallInt
  startMinute   Int      @map("start_minute") @db.SmallInt
  endMinute     Int      @map("end_minute") @db.SmallInt
  slotMinutes   Int      @map("slot_minutes") @db.SmallInt
  bufferMinutes Int      @default(0) @map("buffer_minutes") @db.SmallInt
  maxPerSlot    Int      @default(1) @map("max_per_slot") @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([serviceId, businessId, weekday])
  @@index([businessId])
  @@map("service_availability")
}

model ServiceBlackout {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(6)
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([serviceId, businessId, startsAt])
  @@index([businessId])
  @@map("service_blackouts")
}

enum ImportJobStatus {
  queued
  processing
  completed
  failed

  @@map("import_job_status")
}

model ImportJob {
  id            String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  businessId    String          @map("business_id") @db.Uuid
  kind          String          @default("products_csv")
  status        ImportJobStatus @default(queued)
  // Private-bucket key of the uploaded CSV
  fileKey       String          @map("file_key")
  fileName      String          @map("file_name")
  totalRows     Int             @default(0) @map("total_rows")
  succeededRows Int             @default(0) @map("succeeded_rows")
