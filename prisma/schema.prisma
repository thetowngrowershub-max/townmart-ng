  in_progress
  completed
  rejected
  cancelled

  @@map("dsr_status")
}

/// A data subject request (NDPA 2023 Part VI), from the Privacy Centre or the public form.
model DataSubjectRequest {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  // DSR-2026-000123
  reference       String    @unique
  type            DsrType
  status          DsrStatus @default(open)
  userId          String?   @map("user_id") @db.Uuid
  email           String    @db.Citext
  name            String?
  details         String?
  // privacy_centre or public_form
  channel         String
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  dueAt           DateTime? @map("due_at") @db.Timestamptz(6)
  assignedTo      String?   @map("assigned_to") @db.Uuid
  resolutionNote  String?   @map("resolution_note")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  // Access/portability exports in the private bucket.
  exportJsonKey   String?   @map("export_json_key")
  exportPdfKey    String?   @map("export_pdf_key")
  exportExpiresAt DateTime? @map("export_expires_at") @db.Timestamptz(6)
  ipHash          String?   @map("ip_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

